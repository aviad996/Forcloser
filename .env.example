# Google Sheets target
GOOGLE_SHEET_ID=your_sheet_id_here
GOOGLE_WORKSHEET_NAME=Miami-Dade

# Path to service-account JSON (local dev). In CI use GOOGLE_SERVICE_ACCOUNT_JSON secret.
GOOGLE_SERVICE_ACCOUNT_FILE=./service_account.json

# How many days ahead of today to scrape (default 14)
LOOKAHEAD_DAYS=14
